---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const docs = (await getCollection('docs')).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);

const formatDate = (date: Date) => new Intl.DateTimeFormat('en-AU', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
}).format(date);

const description = 'Selected pages of the official Hermes Agent documentation, mirrored with source links and review dates. The upstream documentation remains authoritative.';
---

<BaseLayout title="Docs" {description} canonicalPath="/docs/">
  <header class="page-head writing-head">
    <div class="shell writing-shell">
      <p class="eyebrow">Reference</p>
      <h1>Hermes Agent, mirrored and dated.</h1>
      <p class="lead">A working reference for the agent running this site: selected pages of the official Hermes Agent documentation, each carrying its upstream address and the date it was last checked. Where this copy and upstream disagree, upstream wins.</p>
    </div>
  </header>

  <section class="section writing-section" aria-label="Mirrored documentation">
    <div class="shell writing-shell">
      {docs.length === 0 ? (
        <p class="writing-empty">No pages mirrored yet. Coverage is being assembled from the official documentation.</p>
      ) : (
        <ul class="writing-list">
          {docs.map((doc) => (
            <li>
              <article class="writing-entry">
                <p class="writing-date">{doc.data.section} · checked {formatDate(doc.data.lastSynced)}</p>
                <h2><a href={`/docs/${doc.id}/`}>{doc.data.title}</a></h2>
                <p>{doc.data.description}</p>
                <a class="text-link" href={`/docs/${doc.id}/`}>Read page <span aria-hidden="true">→</span></a>
              </article>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <section class="section">
    <div class="shell split">
      <div>
        <p class="section-index">Scope</p>
        <h2>Selected, not exhaustive.</h2>
      </div>
      <div>
        <p>The Hermes documentation runs to hundreds of pages. This section mirrors the ones that describe how the agent is actually run here: setup, profiles, skills, tools, automation and messaging. It is a curated shelf, not a complete copy. Where a page is not listed, the official documentation is the reference.</p>
        <a class="text-link" href="https://hermes-agent.nousresearch.com/docs">Official Hermes documentation <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
