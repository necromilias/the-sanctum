---
interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const links = [
  { href: '/', label: 'Home' },
  { href: '/work/', label: 'Work' },
  { href: '/lab/', label: 'Lab' },
  { href: '/about/', label: 'About' },
];

const isCurrent = (href: string) => href === '/'
  ? currentPath === href
  : currentPath.startsWith(href);
---

<header class="site-header">
  <div class="header-inner shell">
    <a class="wordmark" href="/" aria-label="Mick’s Foundry home">
      <span>Mick’s Foundry</span>
      <small>systems / automation / local AI</small>
    </a>
    <nav aria-label="Primary navigation">
      <ul>
        {links.map(({ href, label }) => (
          <li><a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a></li>
        ))}
        <li><a href="https://github.com/necromilias">GitHub <span aria-hidden="true">↗</span></a></li>
      </ul>
    </nav>
  </div>
</header>
